# 统一行尾：避免 Windows 上编辑后把 CRLF 带进仓库，
# 导致 Linux 复现时 bash 报 `syntax error near unexpected token '$'\r''`。
* text=auto eol=lf

# shell 脚本必须是 LF，否则在 Linux 上无法执行
*.sh            text eol=lf
*.bash          text eol=lf

# Python 同理（CRLF 虽能跑，但 shebang 与部分工具会出问题）
*.py            text eol=lf

# Windows 批处理必须是 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制资源不做行尾转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.pdf           binary
*.pt            binary
*.safetensors   binary
*.bin           binary
*.tgz           binary
*.gz            binary
*.zip           binary
