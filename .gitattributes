# Normalize line endings: keep CRLF out of the repository when editing on Windows,
# which otherwise makes bash fail on Linux with `syntax error near unexpected token '$'\r''`.
* text=auto eol=lf

# Shell scripts must be LF or they cannot execute on Linux
*.sh            text eol=lf
*.bash          text eol=lf

# Same for Python (CRLF runs, but the shebang and some tools break)
*.py            text eol=lf

# Windows batch files must be CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary assets are never line-ending converted
*.png           binary
*.jpg           binary
*.jpeg          binary
*.pdf           binary
*.pt            binary
*.safetensors   binary
*.bin           binary
*.tgz           binary
*.gz            binary
*.zip           binary
